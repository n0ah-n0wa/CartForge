# CartForge local configuration placeholders.
# Copy to .env and replace every change-me value before use.
# Never commit .env or real credentials.

# --- Application ---
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080
LOGGING_LEVEL_ROOT=INFO

# --- PostgreSQL ---
DATABASE_URL=jdbc:postgresql://localhost:5432/ecommerce
DATABASE_USERNAME=ecommerce
DATABASE_PASSWORD=change-me

# --- Redis ---
REDIS_URL=redis://localhost:6379

# --- JWT ---
# Must be a long random value in any real environment. Never hardcode this in source.
JWT_SECRET=change-me-use-a-long-random-value
# Token lifetime in milliseconds.
JWT_EXPIRATION=3600000

# --- CORS ---
# Development may list explicit local origins. Production must use an explicit allowlist.
# Do not use wildcard origins in production when credentials are enabled.
CORS_ORIGINS=http://localhost:3000
