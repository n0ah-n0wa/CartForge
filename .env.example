# CartForge environment placeholders.
# Copy to .env and replace every change-me value before use.
# Never commit .env or real credentials.
#
# Spring Boot does not load .env by itself. Export these variables, pass them
# to the process, or (once added) supply them through Docker Compose.
#
# Activate a profile explicitly. There is no implicit default profile.
#   SPRING_PROFILES_ACTIVE=dev|test|prod
#
# Production ignores development localhost fallbacks. In prod, every marked
# required variable must be set to a real value.

# --- Application ---
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080
LOGGING_LEVEL_ROOT=INFO

# --- PostgreSQL (password is required in every profile) ---
DATABASE_URL=jdbc:postgresql://localhost:5432/ecommerce
DATABASE_USERNAME=ecommerce
DATABASE_PASSWORD=change-me

# --- Redis ---
REDIS_URL=redis://localhost:6379

# --- JWT (placeholder only; do not implement authentication with this value) ---
# Required in every profile. Production rejects placeholders and short values.
JWT_SECRET=change-me-use-a-long-random-value
# Token lifetime in milliseconds. Required in production; optional elsewhere (default 3600000).
JWT_EXPIRATION=3600000

# --- CORS ---
# Development may list explicit local origins.
# Production must use an explicit allowlist. Do not use * in production.
CORS_ORIGINS=http://localhost:3000

# --- Pagination ---
APP_PAGINATION_DEFAULT_PAGE_SIZE=20
APP_PAGINATION_MAX_PAGE_SIZE=100
