# CartForge environment configuration
# ====================================
#
# 1. Copy this file:  cp .env.example .env
# 2. Replace every `change-me` value in `.env` (never commit `.env`).
# 3. Start the stack:  docker compose up --build
#
# If you change POSTGRES_PASSWORD after the database volume was created, reset it:
#   docker compose down -v && docker compose up --build
#
# Docker Compose reads `.env` for variable substitution in docker-compose.yml
# and injects the same file into containers via env_file.
#
# For local runs outside Docker, use localhost hostnames below.
# For Docker Compose, use the service hostnames documented in each section.

# --- Application ---
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080
LOGGING_LEVEL_ROOT=INFO

# --- PostgreSQL ---
# Docker Compose: postgres service DNS name is `postgres` on the cartforge network.
POSTGRES_DB=ecommerce
POSTGRES_USER=ecommerce
POSTGRES_PASSWORD=change-me

# Application JDBC settings (must match POSTGRES_* above in Docker Compose).
# Local (non-Docker): jdbc:postgresql://localhost:5432/ecommerce
# Docker Compose:      jdbc:postgresql://postgres:5432/ecommerce
DATABASE_URL=jdbc:postgresql://postgres:5432/ecommerce
DATABASE_USERNAME=ecommerce
DATABASE_PASSWORD=change-me

# --- Redis ---
# Local (non-Docker): redis://localhost:6379
# Docker Compose:      redis://redis:6379
REDIS_URL=redis://redis:6379

# --- JWT ---
# Required in every profile. Use at least 32 random characters.
# Production rejects placeholder values and secrets shorter than 32 characters.
JWT_SECRET=change-me-use-a-long-random-value-at-least-32-chars
JWT_EXPIRATION=3600000

# --- CORS ---
# Development: explicit local origins. Production: explicit allowlist (never *).
CORS_ORIGINS=http://localhost:3000

# --- Pagination ---
APP_PAGINATION_DEFAULT_PAGE_SIZE=20
APP_PAGINATION_MAX_PAGE_SIZE=100

# --- Auth rate limiting (fixed window per client IP) ---
APP_RATE_LIMIT_AUTH_ENABLED=true
APP_RATE_LIMIT_AUTH_LIMIT=20
APP_RATE_LIMIT_AUTH_WINDOW_SECONDS=60

# --- Docker build ---
# Default image expects a host-built JAR (see Quick start below).
# CI / unrestricted networks may set:  DOCKERFILE=docker/Dockerfile.ci
# DOCKERFILE=Dockerfile
#
# Quick start:
#   cp .env.example .env          # set POSTGRES_PASSWORD and JWT_SECRET
#   ./mvnw package -DskipTests    # produces target/ecommerce-api-*.jar
#   docker compose up --build

# --- JVM (optional) ---
# JAVA_OPTS=-XX:+UseContainerSupport -XX:MaxRAMPercentage=75.0
